{{!--
    Parameters:
    - addPostNumber: Boolean
--}}

<div class="tag-card">
    <a href="{{url}}" class="card-image-link" aria-label="link to: {{title}}">
        {{#if feature_image}}                   
            <figure>
                <img
                    srcset="{{img_url feature_image size="xs"}} 150w,
                            {{img_url feature_image size="s"}} 300w,
                            {{img_url feature_image size="m"}} 720w,
                            {{img_url feature_image size="l"}} 960w"
                    src="{{img_url feature_image size="l"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                >
            </figure>                   
        {{else}}
            <div class="placeholder">
                {{> "icons/placeholder" }}
            </div>                  
        {{/if}}
    </a>
    <a class="tag-heading-link" href="{{url}}">
        <div class="big-text">{{name}}</div>
    </a>
    {{#if addPostNumber}}
        <p class="post-number">{{count.posts}} {{t "posts"}}</p>
    {{/if}}
</div>