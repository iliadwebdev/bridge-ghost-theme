<link rel="stylesheet" type="text/css" href="{{asset "css/footer.css"}}" />

<custom-footer>
    <nav class="footer-navigation">
        {{navigation type="secondary" }}
    </nav>

    <div class="footer-socials">
        <h2 class="footer-subscribe-heading">{{t "Subscribe to our newsletter"}}</h2>
        <div class="action-wrapper">
            {{> "components/subscribe"}}
        </div>
        <div class="footer-socials-inner">
            <a href="{{facebook_url @site.facebook}}" target="_blank" class="social" aria-label="Facebook">
                <div class="social-inner">
                    {{> "icons/facebook-icon"}}
                </div>
            </a>

            <a href="{{twitter_url @site.twitter}}" class="social" target="_blank" aria-label="Twitter">
                <div class="social-inner">
                    {{> "icons/twitter-icon"}}
                </div>
            </a>

            {{#if @custom.linkedin_url}}
                <a href="{{@custom.linkedin_url}}" class="social" target="_blank" aria-label="Linkedin">
                    <div class="social-inner">
                        {{> "icons/linkedin-icon"}}
                    </div>
                </a>
            {{/if}}

            {{#if @custom.instagram_url}}
                <a href="{{@custom.instagram_url}}" class="social" target="_blank" aria-label="Instagram">
                    <div class="social-inner">
                        {{> "icons/instagram-icon"}}
                    </div>
                </a>
            {{/if}}
        </div>
    </div>

    <div class="footer-credits">
        <span>&copy; {{date format="YYYY"}}&nbsp;</span><a href="{{@site.url}}">{{@site.title}}</a><span>&nbsp;- {{t "Published with"}}&nbsp;</span><a href="https://ghost.org/" target="_blank">Ghost</a><span>&nbsp;&&nbsp;</span><a href="https://www.kusa-projects.com/" target="_blank">{{@site.title}}</a>
    </div>
    <span id="no-footer-form-text" style="display: none; width: 0px; height: 0px;" data-no-footer-form-text="{{t 'Follow us on social media'}}"></span>
</custom-footer>