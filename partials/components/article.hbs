{{!--
    Parameters:
    - isPost: Boolean
--}}

<article>
    {{#match @page.show_title_and_feature_image}}
        <header class="post-header">
            <div class="post-header-text {{#if @custom.narrow_post_header}}narrow-container{{/if}}{{#unless feature_image}} narrow-container{{/unless}}">
                {{#if isPost}}
                    <a href="{{primary_tag.url}}"class="post-tag medium-text">{{primary_tag.name}}</a>
                {{/if}}
                <h1 class="{{#if isPost}}post-title{{/if}}">{{title}}</h1>
                <div class="excerpt-and-metadata{{#unless isPost}} excerpt-margin-top{{/unless}}">
                    {{#if custom_excerpt}}
                        <div class="post-excerpt">
                            <p>{{custom_excerpt}}</p>
                        </div>
                    {{/if}}
                    {{#if isPost}}
                        <div class="post-authors">
                            <div class="post-author-images">
                                {{#foreach authors}}                                
                                    <a href="{{url}}" class="post-author-image">
                                        {{#if profile_image}}
                                            <img class="image" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy">
                                        {{else}}
                                            {{> "icons/avatar"}}
                                        {{/if}}
                                    </a>
                                {{/foreach}}
                            </div>
                            <div class="post-authors-text">
                                <div class="post-authors-inner medium-text" id="authors">
                                    {{#foreach authors}}
                                        <span>
                                            <a href="{{url}}" class="post-author-name">{{name}}</a>
                                        </span>
                                        <span class="author-and">
                                            &nbsp;&&nbsp;
                                        </span>
                                    {{/foreach}}
                                </div>
                                <div class="date-small-text">
                                    <span>
                                        <time>
                                            {{date published_at format="MMM DD, YYYY"}}
                                        </time>
                                    </span>
                                    <span> - </span>
                                    <span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
                                </div>
                            </div>                            
                        </div>
                    {{/if}}                    
                </div>
            </div>

            {{#if feature_image}}
                <div class="post-main-image {{#if @custom.narrow_post_header}}narrow-container{{/if}}">
                    <figure>
                        <img
                            class="{{#if @custom.narrow_post_header}}post-image-full-borders{{/if}}"
                            srcset="{{img_url feature_image size="s"}} 300w,
                                    {{img_url feature_image size="m"}} 720w,
                                    {{img_url feature_image size="l"}} 960w,
                                    {{img_url feature_image size="xl"}} 1200w,
                                    {{img_url feature_image size="xxl"}} 2000w"
                            src="{{img_url feature_image size="xl"}}"
                            alt="{{title}}"
                        >
                        {{#if feature_image_caption}}
                            <figcaption class="{{#if @custom.narrow_post_header}}narrow-container{{/if}}">{{feature_image_caption}}</figcaption>
                        {{/if}}
                    </figure>
                </div>
            {{/if}}
        </header>
    {{/match}}

    <section class="post-content narrow-container {{#unless feature_image}}no-padding-top{{/unless}}">
        {{content}}

        {{#if isPost}}
            <div class="post-share-icons">
                <a href="https://www.facebook.com/sharer.php?u={{url absolute='true'}}" target="_blank" rel="noopener" class="social" aria-label="Share on Facebook">
                    <div class="social-inner">
                        {{> "icons/facebook-icon"}}
                    </div>
                </a>

                <a href="https://twitter.com/intent/tweet?url={{url absolute='true'}}&amp;text={{encode title}}" target="_blank" rel="noopener" class="social" aria-label="Share on Twitter">
                    <div class="social-inner">
                        {{> "icons/twitter-icon"}}
                    </div>
                </a>

                <a href="https://www.linkedin.com/shareArticle?mini=true&amp;url={{url absolute='true'}}&amp;title={{encode title}}" target="_blank" rel="noopener" class="social" aria-label="Share on Linkedin">
                    <div class="social-inner">
                        {{> "icons/linkedin-icon"}}
                    </div>
                </a>

                <button class="social clipboard-link unstyled-button" aria-label="Copy Link">
                    <div class="social-inner">
                        {{> "icons/link-icon"}}
                    </div>
                </button>

                <div class="clipboard-alert">
                    <small>{{t "The link has been copied!"}}</small>
                </div>
            </div>
        {{/if}}
    </section>
    {{#if isPost}}
        <footer>      
            {{#if comments}}                          
                <div class="comments-container">
                    {{> "components/section-header" id="member-discussion-header" heading=(t "Member discussion") text=(comment_count empty=(t "0 comments") singular=(t "comment") plural=(t "comments") autowrap="false")}}
                    {{comments title="" count=false}}
                </div>                   
            {{/if}}

            <div class="related-posts">
                <div class="previous-post">
                    {{#prev_post}}
                        {{> "components/related-card" heading=(t "Prev post")}}
                    {{/prev_post}}
                </div>
                
                <div class="next-post">
                    {{#next_post}}
                        {{> "components/related-card" heading=(t "Next post")}}
                    {{/next_post}}
                </div>                
            </div>
        </footer>
    {{/if}}
</article>

<script src="https://cdn.jsdelivr.net/npm/lightense-images@1.0.17/dist/lightense.min.js"></script>
<script>
  window.addEventListener('load', function () {
    const imagesInAnchors = document.querySelectorAll('.post-content a img, .post-content .kg-product-card img, .kg-signup-card img, .kg-header-card-image');

    imagesInAnchors.forEach((img) => {
        img.classList.add('no-lightense');  
    });

    Lightense('.post-content img:not(.no-lightense)');
  }, false);
</script>