{{!--
    Parameters:
    - action: signin, signup, subscribe
    - columnForm: Boolean
    - noLink: Boolean
--}}

{{#if @site.members_enabled}}
    <custom-form class="form-container">
        <form data-members-form="{{action}}" data-members-autoredirect="false" class="subscribe-form">
            <div class="subscribe-with-alerts">
                <div class="subscribe-wrapper{{#if columnForm}} column-form{{/if}}">
                    {{#if columnForm}}
                        <input data-members-name type="text" required="true" placeholder="{{t 'Your name'}}" class="subscribe-input"/>
                    {{/if}}
                    <input data-members-email type="email" required="true" placeholder="{{t 'Your email address'}}" class="subscribe-input"/>
                    <button class="{{#if columnForm}}wide-button{{/if}}" type="submit">{{t "Continue"}}</button>
                </div>
                <div class="subscribe-alerts">
                    <small class="subscribe-alert loading-alert">{{t "Processing your request..."}}</small>
                    <small class="subscribe-alert error-alert" data-members-error></small>
                </div> 
            </div>            
        </form>
        {{#unless noLink}}
            {{#unless @site.members_invite_only}}
                <div class="form-small-text">
                    <small><span style="color: var(--text-60-opac);">{{#match action "signin"}}{{t "Don't have an account yet?"}}{{else}}{{t "Already have an account?"}}{{/match}}</span>&nbsp;<a class="bold-link" href="{{@site.url}}/{{#match action "signin"}}signup{{else}}signin{{/match}}/">{{#match action "signin"}}{{t "Sign up"}}{{else}}{{t "Sign in"}}{{/match}}</a></small>
                </div>
            {{/unless}}
        {{/unless}}
        <a href="{{@site.url}}" class="button wide-button back-home-button">{{t "Back to homepage"}}</a>
        <span id="form-success-heading-text" style="display: none; width: 0px; height: 0px;" data-success-heading="{{t 'Great!'}}"></span>
        <span id="form-success-paragraph-text" style="display: none; width: 0px; height: 0px;" data-success-paragraph="
            {{#match action "signup"}}{{t 'Please check your inbox and click the link to confirm your signup.'}}{{/match}}
            {{#match action "signin"}}{{t 'Please check your inbox and click the link to complete signin.'}}{{/match}}
            {{#match action "subscribe"}}{{t 'Please check your inbox and click the link to confirm your subscription.'}}{{/match}}
            "></span>
    </custom-form>
{{/if}}